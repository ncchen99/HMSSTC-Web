---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FloatingSatellites from "../../components/FloatingSatellites.astro";
import { getCollection } from "astro:content";

const allAlbums = await getCollection("gallery");
const albums = allAlbums
  .filter((a) => a.id !== "example-album")
  .sort((a, b) => {
    if (a.data.order !== undefined && b.data.order !== undefined) {
      return a.data.order - b.data.order;
    }
    return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
  });
---

<BaseLayout
  title="活動相簿 | 夏漢民太空科技中心"
  pageTitleKey="gallery.pageTitle"
>
  <div class="pt-36 pb-20 bg-white min-h-screen relative overflow-hidden">
    <FloatingSatellites id="gallery-list" />
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">

      <!-- Breadcrumb -->
      <!-- <nav class="flex items-center gap-2 text-sm text-gray-400 mb-8">
        <a href="/" class="hover:text-tech-blue transition-colors" data-i18n="gallery.breadcrumbHome">首頁</a>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3 h-3">
          <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
        </svg>
        <span class="text-gray-600" data-i18n="gallery.breadcrumbGallery">相簿</span>
      </nav> -->

      <!-- Header -->
      <div class="mb-12">
        <h1
          class="text-2xl md:text-4xl sm:text-3xl font-heading font-bold text-gray-900 mb-4"
          data-i18n="gallery.heading"
        >
          活動相簿
        </h1>
        <p class="text-gray-500 text-lg" data-i18n="gallery.description">
          珍藏中心活動的每一個精彩瞬間
        </p>
      </div>

      <!-- Albums Grid -->
      {albums.length === 0 ? (
        <div class="text-center py-24 text-gray-400">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" class="w-16 h-16 mx-auto mb-4 opacity-30">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
          </svg>
          <p class="text-lg">尚無相簿，請執行上傳腳本後重新建置。</p>
          <p class="text-sm mt-2 font-mono bg-gray-50 inline-block px-3 py-1 rounded">node tools/upload-photos.mjs</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {albums.map((album, index) => (
            <article class="group relative bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-500 card-hover border border-gray-100">
              <div class="mission-number text-gray-200">
                {String(index + 1).padStart(2, "0")}
              </div>

              <!-- Cover Image -->
              <a href={`/gallery/${album.id}`} class="block">
                <div class="relative h-52 overflow-hidden bg-gradient-blue">
                  {album.data.cover ? (
                    <img
                      src={album.data.cover}
                      alt={album.data.title}
                      class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                      loading="lazy"
                    />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-tech-blue to-tech-blue-light">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" class="w-16 h-16 text-white/40">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
                      </svg>
                    </div>
                  )}
                  <!-- Photo count badge -->
                  <div class="absolute bottom-3 right-3 bg-black/60 text-white text-xs px-2 py-1 rounded-full flex items-center gap-1 backdrop-blur-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3 h-3">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
                    </svg>
                    <span>
                      {album.data.folders && album.data.folders.length > 0
                        ? album.data.folders.reduce((acc, f) => acc + f.photos.length, 0)
                        : album.data.photos.length}
                    </span>
                    <span data-i18n="gallery.photoCount">張照片</span>
                  </div>
                </div>
              </a>

              <div class="p-6 pt-8">
                <h2
                  class="text-lg font-heading font-bold text-gray-900 mb-2 line-clamp-2 group-hover:text-tech-blue transition-colors"
                  data-lang-content="zh-TW"
                >
                  {album.data.title}
                </h2>
                <h2
                  class="text-lg font-heading font-bold text-gray-900 mb-2 line-clamp-2 group-hover:text-tech-blue transition-colors"
                  data-lang-content="en"
                  style="display: none;"
                >
                  {album.data.titleEn ?? album.data.title}
                </h2>
                <div class="flex items-center text-sm text-gray-500 mb-4 group-hover:text-tech-blue/80 transition-colors">
                  <span data-i18n="gallery.datePrefix" class="mr-1.5">發布時間</span>
                  {album.data.date}
                </div>
                {(album.data.description || album.data.descriptionEn) && (
                  <>
                    <p class="text-gray-600 text-sm line-clamp-3 mb-4" data-lang-content="zh-TW">
                      {album.data.description}
                    </p>
                    <p class="text-gray-600 text-sm line-clamp-3 mb-4" data-lang-content="en" style="display: none;">
                      {album.data.descriptionEn ?? album.data.description}
                    </p>
                  </>
                )}
                <a
                  href={`/gallery/${album.id}`}
                  class="inline-flex items-center gap-2 text-tech-blue font-medium text-sm hover:gap-3 transition-all duration-300"
                >
                  <span data-i18n="gallery.viewAlbum">瀏覽相簿</span>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                  </svg>
                </a>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </div>
</BaseLayout>
