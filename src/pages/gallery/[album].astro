---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FloatingSatellites from "../../components/FloatingSatellites.astro";
import PhotoGallery from "../../components/PhotoGallery.tsx";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const albums = await getCollection("gallery");
  return albums
    .filter((a) => a.id !== "example-album")
    .map((album) => ({
      params: { album: album.id },
      props: { album },
    }));
}

const { album } = Astro.props;
const { title, titleEn, date, description, descriptionEn, photos } = album.data;
---

<BaseLayout
  title={`${title} | 相簿 | 夏漢民太空科技中心`}
  pageTitleKey="gallery.pageTitle"
>
  <div class="pt-36 pb-20 bg-white min-h-screen relative overflow-hidden">
    <FloatingSatellites id="gallery-album" />
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">

      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm text-gray-400 mb-8 flex-wrap">
        <a href="/" class="hover:text-tech-blue transition-colors" data-i18n="gallery.breadcrumbHome">首頁</a>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3 h-3 flex-shrink-0">
          <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
        </svg>
        <a href="/gallery" class="hover:text-tech-blue transition-colors" data-i18n="gallery.breadcrumbGallery">相簿</a>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3 h-3 flex-shrink-0">
          <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
        </svg>
        <span class="text-gray-600 truncate max-w-xs" data-lang-content="zh-TW">{title}</span>
        <span class="text-gray-600 truncate max-w-xs" data-lang-content="en" style="display:none;">{titleEn ?? title}</span>
      </nav>

      <!-- Header -->
      <div class="mb-10">
        <div class="flex items-start justify-between flex-wrap gap-4">
          <div>
            <h1 class="text-2xl md:text-4xl sm:text-3xl font-heading font-bold text-gray-900 mb-3" data-lang-content="zh-TW">
              {title}
            </h1>
            <h1 class="text-2xl md:text-4xl sm:text-3xl font-heading font-bold text-gray-900 mb-3" data-lang-content="en" style="display:none;">
              {titleEn ?? title}
            </h1>
            <p class="text-sm text-gray-500 mb-2">
              <span data-i18n="activitiesPage.datePrefix">公告時間</span>{" "}
              {date}
              {photos.length > 0 && (
                <span class="ml-3 text-tech-blue font-medium">
                  {photos.length} <span data-i18n="gallery.photoCount">張照片</span>
                </span>
              )}
            </p>
            {(description || descriptionEn) && (
              <>
                <p class="text-gray-600 text-base mt-3 max-w-2xl" data-lang-content="zh-TW">{description}</p>
                <p class="text-gray-600 text-base mt-3 max-w-2xl" data-lang-content="en" style="display:none;">{descriptionEn ?? description}</p>
              </>
            )}
          </div>
          <a
            href="/gallery"
            class="inline-flex items-center gap-2 text-gray-500 hover:text-tech-blue transition-colors text-sm flex-shrink-0 mt-1"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
            </svg>
            <span data-i18n="gallery.backToGallery">返回相簿列表</span>
          </a>
        </div>
      </div>

      <!-- Divider -->
      <div class="border-t border-gray-100 mb-8"></div>

      <!-- Photo Grid with React component (client-side for lazy loading + lightbox) -->
      <PhotoGallery
        client:load
        photos={photos}
        albumTitle={title}
      />
    </div>
  </div>
</BaseLayout>
