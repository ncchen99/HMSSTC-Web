---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import type { GetStaticPaths } from "astro";

export const getStaticPaths: GetStaticPaths = async () => {
  const allNews = await getCollection("news");

  // Filter out English entries (ending with .en.md)
  // Note: entry.id usually contains the filename including extension relative to conten collection root
  const baseEntries = allNews.filter((entry) => !entry.id.endsWith(".en.md"));

  return Promise.all(
    baseEntries.map(async (entry) => {
      // Find corresponding English entry
      // Assumes file naming convention: slug.md -> slug.en.md
      const enId = entry.id.replace(".md", ".en.md");
      const translatedEntry = allNews.find((e) => e.id === enId);

      return {
        params: { slug: entry.slug },
        props: { entry, translatedEntry },
      };
    }),
  );
};

interface Props {
  entry: CollectionEntry<"news">;
  translatedEntry?: CollectionEntry<"news">;
}

const { entry, translatedEntry } = Astro.props;
const { Content } = await entry.render();
const TranslatedContent = translatedEntry
  ? (await translatedEntry.render()).Content
  : null;
---

<BaseLayout
  title={`${entry.data.title} | 夏漢民太空科技中心`}
  titleEn={translatedEntry
    ? `${translatedEntry.data.title} | HMSSTC`
    : undefined}
>
  <div class="pt-28 pb-20 bg-white min-h-screen">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="mb-8 text-sm">
        <a
          href="/"
          class="text-gray-400 hover:text-tech-blue transition-colors"
          data-i18n="common.home">首頁</a
        >
        <span class="text-gray-300 mx-2">/</span>
        <a
          href="/news"
          class="text-gray-400 hover:text-tech-blue transition-colors"
          data-i18n="nav.news">最新消息</a
        >
        <span class="text-gray-300 mx-2">/</span>
        <span class="text-gray-600" data-lang-content="zh-TW"
          >{entry.data.title}</span
        >
        {
          translatedEntry ? (
            <span
              class="text-gray-600"
              data-lang-content="en"
              style="display: none;"
            >
              {translatedEntry.data.title}
            </span>
          ) : (
            <span
              class="text-gray-600"
              data-lang-content="en"
              style="display: none;"
            >
              {entry.data.title}
            </span>
          )
        }
      </nav>

      <!-- Hero image -->
      {
        entry.data.image && (
          <div class="relative h-64 md:h-96 rounded-2xl overflow-hidden mb-10">
            {typeof entry.data.image === "string" ? (
              <img
                src={entry.data.image}
                alt={entry.data.title}
                class="w-full h-full object-cover"
              />
            ) : (
              <Image
                src={entry.data.image}
                alt={entry.data.title}
                class="w-full h-full object-cover"
              />
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent" />
          </div>
        )
      }

      <!-- Meta (Chinese) -->
      <div class="mb-8" data-lang-content="zh-TW">
        <h1
          class="text-3xl md:text-4xl font-heading font-bold text-gray-900 mb-4"
        >
          {entry.data.title}
        </h1>
        <p class="text-gray-500">公告時間 {entry.data.date}</p>
      </div>

      <!-- Meta (English) -->
      <div class="mb-8" data-lang-content="en" style="display: none;">
        <h1
          class="text-3xl md:text-4xl font-heading font-bold text-gray-900 mb-4"
        >
          {translatedEntry ? translatedEntry.data.title : entry.data.title}
        </h1>
        <p class="text-gray-500">
          Published {
            translatedEntry ? translatedEntry.data.date : entry.data.date
          }
        </p>
      </div>

      <!-- Content (Chinese) -->
      <div
        class="prose prose-lg max-w-none prose-headings:font-heading prose-headings:text-gray-900 prose-p:text-gray-600 prose-a:text-tech-blue"
        data-lang-content="zh-TW"
      >
        <Content />
      </div>

      <!-- Content (English) -->
      <div
        class="prose prose-lg max-w-none prose-headings:font-heading prose-headings:text-gray-900 prose-p:text-gray-600 prose-a:text-tech-blue"
        data-lang-content="en"
        style="display: none;"
      >
        {
          TranslatedContent ? (
            <TranslatedContent />
          ) : (
            <>
              <div class="p-4 bg-yellow-50 border border-yellow-200 rounded-lg text-yellow-800 mb-4">
                Content not available in English.
              </div>
              <div class="opacity-50">
                <Content />
              </div>
            </>
          )
        }
      </div>

      <!-- Back -->
      <div class="mt-12 pt-8 border-t border-gray-100">
        <a
          href="/news"
          class="inline-flex items-center gap-2 text-tech-blue font-medium hover:gap-3 transition-all duration-300"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            class="w-4 h-4"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"></path>
          </svg>
          <span data-i18n="news.moreNews">返回最新消息</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
