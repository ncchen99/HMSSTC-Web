---
import BaseLayout from '../layouts/BaseLayout.astro';
import FloatingSatellites from '../components/FloatingSatellites.astro';
import { getCollection } from 'astro:content';

const missions = (await getCollection('missions')).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const members = (await getCollection('members')).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const news = (await getCollection('news')).sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<BaseLayout>
  <!-- ========== HERO SECTION ========== -->
  <section class="hero-section relative min-h-screen flex flex-col items-center justify-center overflow-hidden pt-24 pb-32 sm:pt-32 sm:pb-36" id="hero-section">
    <!-- Deep Space Background -->
    <div class="absolute inset-0 hero-bg">
      <img src="/images/banner.webp" alt="HMSSTC Banner" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-space-dark/60"></div>
    </div>

    <!-- Animated star layers -->
    <div class="stars-layer stars-small"></div>
    <div class="stars-layer stars-medium"></div>
    <div class="stars-layer stars-large"></div>

    <!-- Subtle radial glow -->
    <div class="absolute inset-0 hero-radial-glow"></div>

    <!-- Floating particles -->
    <div class="hero-particle" style="top: 15%; right: 8%; animation-delay: 0s;"></div>
    <div class="hero-particle" style="top: 60%; left: 5%; animation-delay: 1.5s;"></div>
    <div class="hero-particle hero-particle--accent" style="top: 25%; left: 12%; animation-delay: 0.8s;"></div>
    <div class="hero-particle" style="bottom: 30%; right: 15%; animation-delay: 2.2s;"></div>

    <!-- Content -->
    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center flex flex-col items-center justify-center">
      <!-- Main Title -->
      <h1
        class="hero-title text-4xl sm:text-5xl lg:text-6xl font-bold font-heading text-white mb-8 mt-20 sm:mb-10 leading-tight tracking-wide"
        id="hero-title"
        data-i18n="hero.title"
      >
        夏漢民太空科技中心
      </h1>

      <!-- Subtitle Box -->
      <div class="hero-subtitle-box max-w-3xl mx-auto mb-10 sm:mb-14">
        <p
          class="text-base sm:text-lg md:text-xl text-gray-300 leading-relaxed px-8 py-5 rounded-lg border border-white/20 bg-white/5 backdrop-blur-sm"
          data-i18n="hero.subtitle"
        >
          啟動臺灣太空新視界｜匯聚前沿科研、跨域人才與國際合作，領航未來太空時代
        </p>
      </div>

      <!-- Stats Row -->
      <div class="hero-stats flex items-center justify-center gap-10 sm:gap-16 mb-5 sm:mb-16">
        <div class="flex items-center gap-4">
          <span class="text-gray-300 text-lg" data-i18n="hero.madeInTaiwan">臺灣製造</span>
          <img src="/images/taiwan.svg" alt="Taiwan" class="w-12 h-12 object-contain opacity-90" />
        </div>
        <div class="w-px h-10 bg-white/20"></div>
        <div class="flex items-center gap-3">
          <span class="text-gray-300 text-lg" data-i18n="hero.missionCount">任務次數</span>
          <span class="text-4xl sm:text-5xl font-display font-bold text-neon-green" id="mission-counter">9</span>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-12 left-1/2 -translate-x-1/2 flex flex-col items-center gap-3">
      <div class="scroll-mouse"></div>
      <span class="text-xs text-gray-400 tracking-[0.3em] font-mono" data-i18n="hero.scroll">Scroll</span>
    </div>
  </section>

  <!-- ========== MISSIONS SECTION ========== -->
  <section class="relative py-24 bg-white overflow-hidden" id="missions">
    <FloatingSatellites id="index-missions" />
    <!-- Decorative top gradient -->
    <div class="absolute top-0 right-0 w-1/3 h-full bg-gradient-to-l from-accent-teal/10 to-transparent pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold text-gray-900 mb-10" data-i18n="missions.title">
        參與國家太空任務
      </h2>

      <!-- Status tabs -->
      <div class="flex gap-4 mb-12">
        <button
          class="mission-tab px-6 py-3 rounded-lg font-medium transition-all duration-300 bg-tech-blue text-white"
          data-status="active"
          data-i18n="missions.active"
        >
          執行中任務
        </button>
        <button
          class="mission-tab px-6 py-3 rounded-lg font-medium transition-all duration-300 bg-gray-100 text-gray-600 hover:bg-gray-200"
          data-status="retired"
          data-i18n="missions.retired"
        >
          除役任務
        </button>
      </div>

      <!-- Mission Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="missions-grid">
        {missions.map((mission, index) => (
          <article
            class="mission-card group relative bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-500 card-hover"
            data-status={mission.data.status}
          >
            <!-- Number -->
            <div class="mission-number">{String(index + 1).padStart(2, '0')}</div>

            <!-- Image -->
            <div class="relative h-56 overflow-hidden">
              {mission.data.image && (
                <img
                  src={mission.data.image}
                  alt={mission.data.title}
                  class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                  loading="lazy"
                />
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent"></div>
            </div>

            <!-- Content -->
            <div class="p-6 pt-8">
              <h3 class="text-xl font-heading font-bold text-gray-900 mb-2">{mission.data.title}</h3>
              <p class="text-sm text-gray-500 mb-3"><span data-i18n="missions.datePrefix">公告時間</span> {mission.data.date}</p>
              <p class="text-gray-600 text-sm line-clamp-2 mb-4">{mission.data.excerpt}</p>
              <a
                href={`/missions/${mission.slug}`}
                class="inline-flex items-center gap-2 text-tech-blue font-medium text-sm hover:gap-3 transition-all duration-300"
              >
                <span data-i18n="missions.readMore">了解更多</span>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- More link -->
      <div class="mt-12 text-center">
        <a href="/missions" class="btn-primary bg-tech-blue text-white">
          <span data-i18n="missions.moreInfo">更多資訊</span>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ========== NEWS PREVIEW SECTION ========== -->
  <section class="relative py-24 bg-gray-50" id="news-preview">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold text-gray-900 mb-10" data-i18n="news.title">
        最新消息
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {news.slice(0, 3).map((item, index) => (
          <article class="group relative bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-500 card-hover">
            <div class="mission-number text-gray-200">{String(index + 1).padStart(2, '0')}</div>
            <div class="relative h-52 overflow-hidden">
              {item.data.image && (
                <img
                  src={item.data.image}
                  alt={item.data.title}
                  class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                  loading="lazy"
                />
              )}
            </div>
            <div class="p-6 pt-8">
              <h3 class="text-lg font-heading font-bold text-gray-900 mb-2 line-clamp-2 group-hover:text-tech-blue transition-colors">
                {item.data.title}
              </h3>
              <p class="text-sm text-gray-500 mb-3"><span data-i18n="news.datePrefix">公告時間</span> {item.data.date}</p>
              <p class="text-gray-600 text-sm line-clamp-2 mb-4">{item.data.excerpt}</p>
              <a
                href={`/news/${item.slug}`}
                class="inline-flex items-center gap-2 text-tech-blue font-medium text-sm hover:gap-3 transition-all duration-300"
              >
                <span data-i18n="news.readMore">了解更多</span>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-12 text-center">
        <a href="/news" class="btn-primary bg-tech-blue text-white">
          <span data-i18n="news.moreNews">更多消息</span>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ========== TEAM SECTION ========== -->
  <section class="relative py-24 overflow-hidden" id="team">
    <!-- Background -->
    <div class="absolute inset-0">
      <img
        src="/images/team-bk.webp"
        alt=""
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-space-dark/90 via-space-dark/80 to-space-dark"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title" data-i18n="team.title">團隊成員</h2>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-7 gap-6">
        {members.map((member) => (
          <a
            href={`/members/${member.slug}`}
            class="team-member-card group text-center block"
          >
            <div class="relative w-full aspect-square rounded-xl overflow-hidden mb-4 bg-white/5 border border-white/10 group-hover:border-tech-blue/50 transition-all duration-300">
              {member.data.image ? (
                <img
                  src={member.data.image}
                  alt={member.data.name}
                  class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                  loading="lazy"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center bg-gray-700/50">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" class="w-16 h-16 text-gray-500">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                  </svg>
                </div>
              )}
              <!-- Hover overlay -->
              <div class="absolute inset-0 bg-gradient-to-t from-tech-blue/80 via-tech-blue/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end justify-center pb-3">
                <span class="inline-flex items-center gap-1 text-white text-xs font-medium">
                  <span data-i18n="team.more">更多</span>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3 h-3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                  </svg>
                </span>
              </div>
            </div>
            <h3 class="text-white font-bold text-sm mb-1 group-hover:text-tech-blue transition-colors duration-300">{member.data.name}</h3>
            <p class="text-gray-400 text-xs leading-relaxed">{member.data.affiliation}</p>
            <p class="text-gray-500 text-xs">{member.data.title}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ===== Hero Background ===== */
  .hero-bg {
    background: radial-gradient(ellipse at 50% 50%, #0a1628 0%, #050d1a 40%, #020810 70%, #000205 100%);
  }

  .hero-radial-glow {
    background:
      radial-gradient(ellipse 800px 600px at 50% 55%, rgba(30, 60, 120, 0.15) 0%, transparent 70%),
      radial-gradient(ellipse 400px 300px at 70% 40%, rgba(50, 80, 160, 0.08) 0%, transparent 60%);
    pointer-events: none;
  }

  /* ===== Animated Stars ===== */
  .stars-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .stars-small {
    background-image:
      radial-gradient(1px 1px at 10% 20%, rgba(255,255,255,0.5), transparent),
      radial-gradient(1px 1px at 25% 45%, rgba(255,255,255,0.3), transparent),
      radial-gradient(1px 1px at 40% 15%, rgba(255,255,255,0.4), transparent),
      radial-gradient(1px 1px at 55% 70%, rgba(255,255,255,0.3), transparent),
      radial-gradient(1px 1px at 70% 35%, rgba(255,255,255,0.5), transparent),
      radial-gradient(1px 1px at 85% 60%, rgba(255,255,255,0.3), transparent),
      radial-gradient(1px 1px at 15% 80%, rgba(255,255,255,0.4), transparent),
      radial-gradient(1px 1px at 60% 90%, rgba(255,255,255,0.3), transparent),
      radial-gradient(1px 1px at 90% 10%, rgba(255,255,255,0.4), transparent),
      radial-gradient(1px 1px at 35% 55%, rgba(255,255,255,0.3), transparent),
      radial-gradient(1px 1px at 5% 50%, rgba(255,255,255,0.35), transparent),
      radial-gradient(1px 1px at 50% 30%, rgba(255,255,255,0.4), transparent),
      radial-gradient(1px 1px at 75% 85%, rgba(255,255,255,0.3), transparent),
      radial-gradient(1px 1px at 95% 45%, rgba(255,255,255,0.35), transparent),
      radial-gradient(1px 1px at 20% 95%, rgba(255,255,255,0.3), transparent);
    animation: twinkle 4s ease-in-out infinite alternate;
  }

  .stars-medium {
    background-image:
      radial-gradient(1.5px 1.5px at 18% 38%, rgba(255,255,255,0.6), transparent),
      radial-gradient(1.5px 1.5px at 48% 58%, rgba(255,255,255,0.5), transparent),
      radial-gradient(1.5px 1.5px at 78% 22%, rgba(255,255,255,0.55), transparent),
      radial-gradient(1.5px 1.5px at 33% 82%, rgba(255,255,255,0.5), transparent),
      radial-gradient(1.5px 1.5px at 62% 42%, rgba(255,255,255,0.6), transparent),
      radial-gradient(1.5px 1.5px at 92% 75%, rgba(255,255,255,0.45), transparent),
      radial-gradient(1.5px 1.5px at 8% 65%, rgba(255,255,255,0.5), transparent);
    animation: twinkle 6s ease-in-out 1s infinite alternate;
  }

  .stars-large {
    background-image:
      radial-gradient(2px 2px at 22% 28%, rgba(255,255,255,0.7), transparent),
      radial-gradient(2px 2px at 65% 15%, rgba(255,255,255,0.6), transparent),
      radial-gradient(2px 2px at 45% 75%, rgba(255,255,255,0.65), transparent),
      radial-gradient(2.5px 2.5px at 82% 52%, rgba(255,255,255,0.7), transparent),
      radial-gradient(2px 2px at 12% 48%, rgba(255,255,255,0.6), transparent);
    animation: twinkle 5s ease-in-out 2s infinite alternate;
  }

  @keyframes twinkle {
    0% { opacity: 0.6; }
    100% { opacity: 1; }
  }

  /* ===== Floating Particles ===== */
  .hero-particle {
    position: absolute;
    width: 6px;
    height: 6px;
    background: rgba(255, 255, 255, 0.5);
    border-radius: 50%;
    animation: particleFloat 6s ease-in-out infinite;
    z-index: 5;
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.3);
  }

  .hero-particle--accent {
    background: rgba(74, 222, 128, 0.6);
    box-shadow: 0 0 12px rgba(74, 222, 128, 0.4);
  }

  @keyframes particleFloat {
    0%, 100% {
      transform: translateY(0) translateX(0);
      opacity: 0.4;
    }
    25% {
      transform: translateY(-20px) translateX(10px);
      opacity: 0.8;
    }
    50% {
      transform: translateY(-10px) translateX(-5px);
      opacity: 0.5;
    }
    75% {
      transform: translateY(-25px) translateX(8px);
      opacity: 0.9;
    }
  }

  /* ===== Hero Title ===== */
  .hero-title {
    text-shadow:
      0 0 60px rgba(255, 255, 255, 0.08),
      0 0 120px rgba(100, 150, 255, 0.05);
    letter-spacing: 0.08em;
  }

  /* ===== Hero Subtitle Box ===== */
  .hero-subtitle-box p {
    transition: all 0.3s ease;
  }

  .hero-subtitle-box p:hover {
    border-color: rgba(255, 255, 255, 0.35);
    background: rgba(255, 255, 255, 0.08);
  }

  /* ===== Hero Stats ===== */
  .hero-stats {
    animation: fadeInUp 1s ease-out 0.6s both;
  }

  /* ===== Entrance animations ===== */
  .hero-title {
    animation: heroTitleFade 1.2s ease-out both;
  }

  .hero-subtitle-box {
    animation: fadeInUp 1s ease-out 0.3s both;
  }

  @keyframes heroTitleFade {
    0% {
      opacity: 0;
      transform: translateY(30px);
      letter-spacing: 0.15em;
    }
    100% {
      opacity: 1;
      transform: translateY(0);
      letter-spacing: 0.08em;
    }
  }

  @keyframes fadeInUp {
    0% {
      opacity: 0;
      transform: translateY(20px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  // Mission counter animation
  const counter = document.getElementById('mission-counter');
  if (counter) {
    const target = parseInt(counter.textContent || '0');
    let current = 0;
    const duration = 2000;
    const step = target / (duration / 16);

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const animate = () => {
            current += step;
            if (current < target) {
              counter.textContent = Math.floor(current).toString();
              requestAnimationFrame(animate);
            } else {
              counter.textContent = target.toString();
            }
          };
          animate();
          observer.unobserve(entry.target);
        }
      });
    });
    observer.observe(counter);
  }

  // Mission tab filtering
  const tabs = document.querySelectorAll('.mission-tab');
  const cards = document.querySelectorAll('.mission-card');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const status = tab.getAttribute('data-status');

      tabs.forEach(t => {
        t.classList.remove('bg-tech-blue', 'text-white');
        t.classList.add('bg-gray-100', 'text-gray-600');
      });
      tab.classList.remove('bg-gray-100', 'text-gray-600');
      tab.classList.add('bg-tech-blue', 'text-white');

      cards.forEach(card => {
        const cardStatus = card.getAttribute('data-status');
        if (status === 'active') {
          (card as HTMLElement).style.display = cardStatus === 'active' ? '' : 'none';
        } else {
          (card as HTMLElement).style.display = cardStatus === 'retired' ? '' : 'none';
        }
      });
    });
  });

  // Scroll animations
  const animateOnScroll = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('animate-fade-in-up');
        animateOnScroll.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('section > div > h2, .mission-card, article.group').forEach(el => {
    el.classList.add('opacity-0');
    animateOnScroll.observe(el);
  });
</script>
