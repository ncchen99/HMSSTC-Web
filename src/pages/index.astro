---
import BaseLayout from '../layouts/BaseLayout.astro';
import FloatingSatellites from '../components/FloatingSatellites.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import bannerImage from '../assets/images/banner.webp';
import teamBkImage from '../assets/images/team-bk.webp';

const allMissions = await getCollection('missions');
const missions = allMissions
  .filter((entry) => !entry.id.endsWith(".en.md"))
  .map((entry) => {
    const enId = entry.id.replace(".md", ".en.md");
    const translatedEntry = allMissions.find((e) => e.id === enId);
    return { ...entry, translatedEntry };
  })
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const allMembers = await getCollection('members');
const members = allMembers
  .filter((entry) => !entry.id.endsWith(".en.md"))
  .map((entry) => {
    const enId = entry.id.replace(".md", ".en.md");
    const translatedEntry = allMembers.find((e) => e.id === enId);
    return { ...entry, translatedEntry };
  })
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const allNews = await getCollection('news');
const news = allNews
  .filter((entry) => !entry.id.endsWith(".en.md"))
  .map((entry) => {
    const enId = entry.id.replace(".md", ".en.md");
    const translatedEntry = allNews.find((e) => e.id === enId);
    return { ...entry, translatedEntry };
  })
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<BaseLayout transparentHeader={true}>
  <!-- ========== HERO SECTION ========== -->
  <section class="hero-section relative min-h-screen flex flex-col items-center justify-center overflow-hidden pt-24 pb-32 sm:pt-32 sm:pb-36" id="hero-section">
    <!-- Deep Space Background -->
    <div class="absolute inset-0 hero-bg">
      <Image src={bannerImage} alt="HMSSTC Banner" class="w-full h-full object-cover" loading="eager" fetchpriority="high" />
      <div class="absolute inset-0 bg-space-dark/60"></div>
    </div>

    <!-- Single, restrained star layer -->
    <div class="stars-layer stars-small"></div>

    <!-- Subtle radial glow -->
    <div class="absolute inset-0 hero-radial-glow"></div>

    <!-- Content -->
    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center flex flex-col items-center justify-center">
      <div class="relative">
        <h1
          class="hero-title text-3xl sm:text-5xl lg:text-6xl font-bold font-heading mb-8 mt-16 sm:mb-10 leading-tight tracking-[0.12em]"
          id="hero-title"
          data-i18n="hero.title"
          data-content="夏漢民太空科技中心"
        >
          夏漢民太空科技中心
        </h1>
      </div>

      <!-- Subtitle: editorial treatment, gold accent rule above clean text -->
      <div class="hero-subtitle-box max-w-3xl mx-auto mb-10 sm:mb-14 flex flex-col items-center">
        <span class="block w-12 h-px bg-accent mb-6"></span>
        <p
          class="text-base sm:text-lg md:text-xl text-gray-200 leading-relaxed tracking-wide [text-shadow:0_2px_8px_rgba(0,0,0,0.5)]"
          data-i18n="hero.subtitle"
        >
          啟動臺灣太空新視界｜匯聚前沿科研、跨域人才與國際合作，領航未來太空時代
        </p>
      </div>

      <!-- Stats Row -->
      <div class="hero-stats flex items-center justify-center gap-5 sm:gap-16 mb-5 sm:mb-16">
        <div class="flex items-center gap-2 sm:gap-4">
          <span class="text-gray-300 text-lg" data-i18n="hero.madeInTaiwan">臺灣製造</span>
          <img src="/images/taiwan.svg" alt="Taiwan" class="w-12 h-12 object-contain brightness-0 invert drop-shadow-[0_0_5px_rgba(59,130,246,0.8)]" />
        </div>
        <div class="w-px h-8 sm:h-10 bg-white/20"></div>
        <div class="flex items-center gap-2 sm:gap-3">
          <span class="text-gray-300 text-lg" data-i18n="hero.missionCount">任務次數</span>
          <span class="text-4xl sm:text-5xl font-display font-bold text-white drop-shadow-[0_0_10px_rgba(59,130,246,0.8)]" id="mission-counter">9</span>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-12 left-1/2 -translate-x-1/2 flex flex-col items-center gap-3">
      <div class="scroll-mouse"></div>
      <span class="text-xs text-gray-400 tracking-[0.3em] font-mono" data-i18n="hero.scroll">Scroll</span>
    </div>
  </section>

  <!-- ========== MISSIONS SECTION ========== -->
  <section class="relative py-24 bg-white overflow-hidden" id="missions">
    <FloatingSatellites id="index-missions" />
    <!-- Decorative top gradient -->
    <div class="absolute top-0 right-0 w-1/3 h-full bg-gradient-to-l from-accent-teal/10 to-transparent pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <h2 class="text-3xl md:text-3xl lg:text-4xl font-heading font-bold text-gray-900 mb-10" data-i18n="missions.title">
        參與國家太空任務
      </h2>

      <!-- Status tabs -->
      <div class="flex gap-4 mb-12">
        <button
          class="mission-tab px-6 py-3 rounded-md font-medium transition-all duration-300 bg-tech-blue text-white"
          data-status="active"
          data-i18n="missions.active"
        >
          執行中任務
        </button>
        <button
          class="mission-tab px-6 py-3 rounded-md font-medium transition-all duration-300 bg-gray-100 text-gray-600 hover:bg-gray-200"
          data-status="retired"
          data-i18n="missions.retired"
        >
          除役任務
        </button>
      </div>

      <!-- Mission Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="missions-grid">
        {missions.map((mission, index) => (
          <article
            class="mission-card group relative bg-white rounded-lg overflow-hidden border border-gray-100 shadow-card transition-all duration-300 card-hover"
            data-status={mission.data.status}
          >
            <!-- Number -->
            <div class="mission-number">{String(index + 1).padStart(2, '0')}</div>

            <!-- Image -->
            <div class="relative h-56 overflow-hidden">
              {mission.data.image && (
                typeof mission.data.image === 'string' ? (
                  <img
                    src={mission.data.image}
                    alt={mission.data.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                    loading="lazy"
                  />
                ) : (
                  <Image
                    src={mission.data.image}
                    alt={mission.data.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                    loading="lazy"
                  />
                )
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent"></div>
            </div>

            <!-- Content -->
            <div class="p-6 pt-8">
              <h3
                class="text-xl font-heading font-bold text-gray-900 mb-2"
                data-lang-content="zh-TW"
              >
                {mission.data.title}
              </h3>
              <h3
                class="text-xl font-heading font-bold text-gray-900 mb-2"
                data-lang-content="en"
                style="display: none;"
              >
                {mission.translatedEntry?.data.title ?? mission.data.title}
              </h3>
              <p class="text-sm text-gray-500 mb-3">
                <span data-i18n="missions.datePrefix">公告時間</span>
                <span data-lang-content="zh-TW"> {mission.data.date}</span>
                <span data-lang-content="en" style="display: none;">
                  {mission.translatedEntry?.data.date ?? mission.data.date}</span
                >
              </p>
              <p
                class="text-gray-600 text-sm line-clamp-2 mb-4"
                data-lang-content="zh-TW"
              >
                {mission.data.excerpt}
              </p>
              <p
                class="text-gray-600 text-sm line-clamp-2 mb-4"
                data-lang-content="en"
                style="display: none;"
              >
                {mission.translatedEntry?.data.excerpt ?? mission.data.excerpt}
              </p>
              <a
                href={`/missions/${mission.slug}`}
                class="inline-flex items-center gap-2 text-tech-blue font-medium text-sm hover:gap-3 transition-all duration-300"
              >
                <span data-i18n="missions.readMore">了解更多</span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  class="w-4 h-4"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path>
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- More link -->
      <div class="mt-12 text-center">
        <a href="/missions" class="btn-primary bg-tech-blue text-white">
          <span data-i18n="missions.moreInfo">更多資訊</span>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ========== NEWS PREVIEW SECTION ========== -->
  <section class="relative py-24 bg-gray-50 overflow-hidden" id="news-preview">
    <FloatingSatellites id="index-news" />
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <h2 class="text-3xl md:text-3xl lg:text-4xl font-heading font-bold text-gray-900 mb-10" data-i18n="news.title">
        最新消息
      </h2>

      <!-- Featured-first layout: the latest item spans full width as a wide
           feature, the next two sit beside each other below -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {news.slice(0, 3).map((item, index) => {
          const featured = index === 0;
          return (
          <article class={`group relative bg-white rounded-lg overflow-hidden border border-gray-100 shadow-card transition-all duration-300 card-hover ${featured ? 'md:col-span-2 md:flex md:h-80' : ''}`}>
            <div class={`relative overflow-hidden ${featured ? 'h-56 md:h-full md:w-1/2' : 'h-52'}`}>
              {item.data.image && (
                typeof item.data.image === 'string' ? (
                  <img
                    src={item.data.image}
                    alt={item.data.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                    loading="lazy"
                  />
                ) : (
                  <Image
                    src={item.data.image}
                    alt={item.data.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                    loading="lazy"
                  />
                )
              )}
            </div>
            <div class={`p-6 ${featured ? 'md:w-1/2 md:flex md:flex-col md:justify-center' : ''}`}>
              <h3
                class={`font-heading font-bold text-gray-900 mb-2 line-clamp-2 group-hover:text-tech-blue transition-colors ${featured ? 'text-xl md:text-2xl' : 'text-lg'}`}
                data-lang-content="zh-TW"
              >
                {item.data.title}
              </h3>
              <h3
                class={`font-heading font-bold text-gray-900 mb-2 line-clamp-2 group-hover:text-tech-blue transition-colors ${featured ? 'text-xl md:text-2xl' : 'text-lg'}`}
                data-lang-content="en"
                style="display: none;"
              >
                {item.translatedEntry?.data.title ?? item.data.title}
              </h3>
              <p class="text-sm text-gray-500 mb-3">
                <span data-i18n="news.datePrefix">公告時間</span>
                <span data-lang-content="zh-TW"> {item.data.date}</span>
                <span data-lang-content="en" style="display: none;">
                  {item.translatedEntry?.data.date ?? item.data.date}</span
                >
              </p>
              <p
                class={`text-gray-600 text-sm mb-4 ${featured ? 'line-clamp-3' : 'line-clamp-2'}`}
                data-lang-content="zh-TW"
              >
                {item.data.excerpt}
              </p>
              <p
                class={`text-gray-600 text-sm mb-4 ${featured ? 'line-clamp-3' : 'line-clamp-2'}`}
                data-lang-content="en"
                style="display: none;"
              >
                {item.translatedEntry?.data.excerpt ?? item.data.excerpt}
              </p>
              <a
                href={`/news/${item.slug}`}
                class="inline-flex items-center gap-2 text-tech-blue font-medium text-sm hover:gap-3 transition-all duration-300"
              >
                <span data-i18n="news.readMore">了解更多</span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  class="w-4 h-4"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path>
                </svg>
              </a>
            </div>
          </article>
          );
        })}
      </div>

      <div class="mt-12 text-center">
        <a href="/news" class="btn-primary bg-tech-blue text-white">
          <span data-i18n="news.moreNews">更多消息</span>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ========== TEAM SECTION ========== -->
  <section class="relative py-24 overflow-hidden" id="team">
    <!-- Background -->
    <div class="absolute inset-0">
      <Image
        src={teamBkImage}
        alt=""
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-space-dark/90 via-space-dark/80 to-space-dark"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-3xl md:text-3xl lg:text-4xl font-heading font-bold mb-10" data-i18n="team.title">團隊成員</h2>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-7 gap-6">
        {members.filter(m => !m.data.category || m.data.category === 'regular').map((member) => (
          <a
            href={`/members/${member.slug}`}
            class="team-member-card group text-center block"
          >
            <div class="relative w-full aspect-square rounded-lg overflow-hidden mb-4 bg-white/5 border border-white/10 group-hover:border-tech-blue-light/50 transition-all duration-300">
              {member.data.image ? (
                typeof member.data.image === 'string' ? (
                  <img
                    src={member.data.image}
                    alt={member.data.name}
                    class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                    loading="lazy"
                  />
                ) : (
                  <Image
                    src={member.data.image}
                    alt={member.data.name}
                    class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                    loading="lazy"
                  />
                )
              ) : (
                <div class="w-full h-full flex items-center justify-center bg-gray-700/50">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" class="w-16 h-16 text-gray-500">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                  </svg>
                </div>
              )}
              <!-- Hover overlay -->
              <div class="absolute inset-0 bg-gradient-to-t from-tech-blue/80 via-tech-blue/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end justify-center pb-3">
                <span class="inline-flex items-center gap-1 text-white text-xs font-medium">
                  <span data-i18n="team.more">更多</span>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3 h-3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                  </svg>
                </span>
              </div>
            </div>
            <h3
              class="text-white font-bold text-sm mb-1 group-hover:text-tech-blue-light transition-colors duration-300"
              data-lang-content="zh-TW"
            >
              {member.data.name}
            </h3>
            <h3
              class="text-white font-bold text-sm mb-1 group-hover:text-tech-blue-light transition-colors duration-300"
              data-lang-content="en"
              style="display: none;"
            >
              {member.translatedEntry?.data.name ?? member.data.name}
            </h3>
            <p
              class="text-gray-400 text-xs leading-relaxed"
              data-lang-content="zh-TW"
            >
              {member.data.affiliation}
            </p>
            <p
              class="text-gray-400 text-xs leading-relaxed"
              data-lang-content="en"
              style="display: none;"
            >
              {member.translatedEntry?.data.affiliation ??
                member.data.affiliation}
            </p>
            <p class="text-gray-500 text-xs" data-lang-content="zh-TW">
              {member.data.title}
            </p>
            <p
              class="text-gray-500 text-xs"
              data-lang-content="en"
              style="display: none;"
            >
              {member.translatedEntry?.data.title ?? member.data.title}
            </p>
          </a>
        ))}
      </div>

      <h2 class="section-title text-3xl md:text-3xl lg:text-4xl font-heading font-bold mb-10 mt-16">
        <span data-lang-content="zh-TW">諮議委員</span>
        <span data-lang-content="en" style="display: none;">Advisory Committee</span>
      </h2>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-7 gap-6">
        {members.filter(m => m.data.category === 'advisory').map((member) => (
          <a
            href={`/members/${member.slug}`}
            class="team-member-card group text-center block"
          >
            <div class="relative w-full aspect-square rounded-lg overflow-hidden mb-4 bg-white/5 border border-white/10 group-hover:border-tech-blue-light/50 transition-all duration-300">
              {member.data.image ? (
                typeof member.data.image === 'string' ? (
                  <img
                    src={member.data.image}
                    alt={member.data.name}
                    class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                    loading="lazy"
                  />
                ) : (
                  <Image
                    src={member.data.image}
                    alt={member.data.name}
                    class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                    loading="lazy"
                  />
                )
              ) : (
                <div class="w-full h-full flex items-center justify-center bg-gray-700/50">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" class="w-16 h-16 text-gray-500">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                  </svg>
                </div>
              )}
              <!-- Hover overlay -->
              <div class="absolute inset-0 bg-gradient-to-t from-tech-blue/80 via-tech-blue/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end justify-center pb-3">
                <span class="inline-flex items-center gap-1 text-white text-xs font-medium">
                  <span data-i18n="team.more">更多</span>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3 h-3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                  </svg>
                </span>
              </div>
            </div>
            <h3
              class="text-white font-bold text-sm mb-1 group-hover:text-tech-blue-light transition-colors duration-300"
              data-lang-content="zh-TW"
            >
              {member.data.name}
            </h3>
            <h3
              class="text-white font-bold text-sm mb-1 group-hover:text-tech-blue-light transition-colors duration-300"
              data-lang-content="en"
              style="display: none;"
            >
              {member.translatedEntry?.data.name ?? member.data.name}
            </h3>
            <p
              class="text-gray-400 text-xs leading-relaxed"
              data-lang-content="zh-TW"
            >
              {member.data.affiliation}
            </p>
            <p
              class="text-gray-400 text-xs leading-relaxed"
              data-lang-content="en"
              style="display: none;"
            >
              {member.translatedEntry?.data.affiliation ?? member.data.affiliation}
            </p>
            <p class="text-gray-500 text-xs" data-lang-content="zh-TW">
              {member.data.title}
            </p>
            <p
              class="text-gray-500 text-xs"
              data-lang-content="en"
              style="display: none;"
            >
              {member.translatedEntry?.data.title ?? member.data.title}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ===== Hero Background ===== */
  .hero-bg {
    background: radial-gradient(ellipse at 50% 50%, #0a1628 0%, #050d1a 40%, #020810 70%, #000205 100%);
  }

  .hero-radial-glow {
    background:
      radial-gradient(ellipse 800px 600px at 50% 55%, rgba(30, 60, 120, 0.15) 0%, transparent 70%),
      radial-gradient(ellipse 400px 300px at 70% 40%, rgba(50, 80, 160, 0.08) 0%, transparent 60%);
    pointer-events: none;
  }

  /* ===== Animated Stars ===== */
  .stars-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .stars-small {
    background-image:
      radial-gradient(1px 1px at 10% 20%, rgba(255,255,255,0.5), transparent),
      radial-gradient(1px 1px at 25% 45%, rgba(255,255,255,0.3), transparent),
      radial-gradient(1px 1px at 40% 15%, rgba(255,255,255,0.4), transparent),
      radial-gradient(1px 1px at 55% 70%, rgba(255,255,255,0.3), transparent),
      radial-gradient(1px 1px at 70% 35%, rgba(255,255,255,0.5), transparent),
      radial-gradient(1px 1px at 85% 60%, rgba(255,255,255,0.3), transparent),
      radial-gradient(1px 1px at 15% 80%, rgba(255,255,255,0.4), transparent),
      radial-gradient(1px 1px at 60% 90%, rgba(255,255,255,0.3), transparent),
      radial-gradient(1px 1px at 90% 10%, rgba(255,255,255,0.4), transparent),
      radial-gradient(1px 1px at 35% 55%, rgba(255,255,255,0.3), transparent),
