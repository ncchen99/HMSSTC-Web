---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import type { GetStaticPaths } from "astro";

export const getStaticPaths: GetStaticPaths = async () => {
  const allMembers = await getCollection("members");
  const baseEntries = allMembers.filter(
    (entry) => !entry.id.endsWith(".en.md"),
  );

  return baseEntries.map((entry) => {
    const enId = entry.id.replace(".md", ".en.md");
    const translatedEntry = allMembers.find((e) => e.id === enId);
    return {
      params: { slug: entry.slug },
      props: { entry, translatedEntry },
    };
  });
};

const { entry, translatedEntry } = Astro.props;
const { Content } = await entry.render();
const TranslatedContent = translatedEntry
  ? (await translatedEntry.render()).Content
  : null;

interface Props {
  entry: CollectionEntry<"members">;
  translatedEntry?: CollectionEntry<"members">;
}
---

<BaseLayout
  title={`${entry.data.name} | 夏漢民太空科技中心`}
  titleEn={translatedEntry
    ? `${translatedEntry.data.name} | HMSSTC`
    : undefined}
>
  <div class="pt-28 pb-20 bg-white min-h-screen">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="mb-8 text-sm">
        <a
          href="/"
          class="text-gray-400 hover:text-tech-blue transition-colors"
        >
          <span data-lang-content="zh-TW">首頁</span>
          <span data-lang-content="en" style="display: none;">Home</span>
        </a>
        <span class="text-gray-300 mx-2">/</span>
        <span class="text-gray-600" data-lang-content="zh-TW"
          >{entry.data.name}</span
        >
        <span
          class="text-gray-600"
          data-lang-content="en"
          style="display: none;"
        >
          {translatedEntry?.data.name ?? entry.data.name}
        </span>
      </nav>

      <!-- Member hero -->
      <div class="flex flex-col md:flex-row gap-8 mb-12">
        <div
          class="w-48 h-48 rounded-2xl overflow-hidden flex-shrink-0 bg-gray-100"
        >
          {
            entry.data.image ? (
              typeof entry.data.image === "string" ? (
                <img
                  src={entry.data.image}
                  alt={entry.data.name}
                  class="w-full h-full object-cover"
                />
              ) : (
                <Image
                  src={entry.data.image}
                  alt={entry.data.name}
                  class="w-full h-full object-cover"
                />
              )
            ) : (
              <div class="w-full h-full flex items-center justify-center bg-gray-200">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1"
                  stroke="currentColor"
                  class="w-20 h-20 text-gray-400"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"
                  />
                </svg>
              </div>
            )
          }
        </div>
        <div class="flex flex-col justify-center">
          <h1
            class="text-3xl md:text-4xl font-heading font-bold text-gray-900 mb-2"
            data-lang-content="zh-TW"
          >
            {entry.data.name}
          </h1>
          <h1
            class="text-3xl md:text-4xl font-heading font-bold text-gray-900 mb-2"
            data-lang-content="en"
            style="display: none;"
          >
            {translatedEntry?.data.name ?? entry.data.name}
          </h1>
          <p class="text-lg text-gray-600 mb-1" data-lang-content="zh-TW">
            {entry.data.affiliation}
          </p>
          <p
            class="text-lg text-gray-600 mb-1"
            data-lang-content="en"
            style="display: none;"
          >
            {translatedEntry?.data.affiliation ?? entry.data.affiliation}
          </p>
          <p class="text-tech-blue font-medium" data-lang-content="zh-TW">
            {entry.data.title}
          </p>
          <p
            class="text-tech-blue font-medium"
            data-lang-content="en"
            style="display: none;"
          >
            {translatedEntry?.data.title ?? entry.data.title}
          </p>
          {
            entry.data.email && (
              <a
                href={`mailto:${entry.data.email}`}
                class="mt-3 inline-flex items-center gap-2 text-gray-500 hover:text-tech-blue transition-colors text-sm"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                  class="w-4 h-4"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"
                  />
                </svg>
                {entry.data.email}
              </a>
            )
          }
        </div>
      </div>

      <!-- Content -->
      <div
        class="prose prose-lg max-w-none prose-headings:font-heading prose-headings:text-gray-900 prose-p:text-gray-600 prose-a:text-tech-blue prose-li:text-gray-600"
        data-lang-content="zh-TW"
      >
        <Content />
      </div>

      <div
        class="prose prose-lg max-w-none prose-headings:font-heading prose-headings:text-gray-900 prose-p:text-gray-600 prose-a:text-tech-blue prose-li:text-gray-600"
        data-lang-content="en"
        style="display: none;"
      >
        {
          TranslatedContent ? (
            <TranslatedContent />
          ) : (
            <>
              <div class="p-4 bg-yellow-50 border border-yellow-200 rounded-lg text-yellow-800 mb-4">
                Content not available in English.
              </div>
              <div class="opacity-50">
                <Content />
              </div>
            </>
          )
        }
      </div>

      <div class="mt-12 pt-8 border-t border-gray-100">
        <a
          href="/#team"
          class="inline-flex items-center gap-2 text-tech-blue font-medium hover:gap-3 transition-all duration-300"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            class="w-4 h-4"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"></path>
          </svg>
          <span data-lang-content="zh-TW">返回團隊成員</span>
          <span data-lang-content="en" style="display: none;">Back to Team</span
          >
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
