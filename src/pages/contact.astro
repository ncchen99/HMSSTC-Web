---
import BaseLayout from "../layouts/BaseLayout.astro";
import FloatingSatellites from "../components/FloatingSatellites.astro";
import fs from "node:fs";
import path from "node:path";
import matter from "gray-matter";

// Read both language versions
const zhFilePath = path.join(
  process.cwd(),
  "src",
  "content",
  "pages",
  "contact.zh-TW.md",
);
const enFilePath = path.join(
  process.cwd(),
  "src",
  "content",
  "pages",
  "contact.en.md",
);

const zhFileContent = fs.readFileSync(zhFilePath, "utf-8");
const enFileContent = fs.readFileSync(enFilePath, "utf-8");

const { data: zhData } = matter(zhFileContent);
const { data: enData } = matter(enFileContent);
---

<BaseLayout
  title="聯絡我們 | 夏漢民太空科技中心"
  pageTitleKey="contact.pageTitle"
>
  <!-- Hero -->
  <section class="relative pt-28 pb-16 overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="/images/night-starry-sky-background.webp"
        alt=""
        class="w-full h-full object-cover"
      />
      <div
        class="absolute inset-0 bg-gradient-to-b from-space-dark to-space-dark/50"
      >
      </div>
    </div>
    <div
      class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center"
    >
      <h1
        class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-white mb-6"
        data-i18n="contact.heroTitle"
      >
        聯絡我們
      </h1>
      <p class="text-xl text-gray-300" data-i18n="contact.heroSubtitle">
        歡迎與我們聯繫，了解更多合作機會
      </p>
    </div>
  </section>

  <section class="py-20 bg-white relative overflow-hidden">
    <FloatingSatellites id="contact-info" />
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <!-- Contact Info -->
        <div>
          <h2
            class="text-2xl font-heading font-bold text-gray-900 mb-8"
            data-i18n="contact.info"
          >
            聯絡資訊
          </h2>

          <div class="space-y-6 mb-10">
            <div class="flex items-start gap-4 p-4 rounded-xl bg-gray-50">
              <div
                class="w-10 h-10 rounded-lg bg-tech-blue/10 flex items-center justify-center flex-shrink-0"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                  class="w-5 h-5 text-tech-blue"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="font-medium text-gray-900" data-i18n="contact.phone">
                  電話
                </h3>
                <p class="text-gray-600">{zhData.phone}</p>
              </div>
            </div>

            <div class="flex items-start gap-4 p-4 rounded-xl bg-gray-50">
              <div
                class="w-10 h-10 rounded-lg bg-tech-blue/10 flex items-center justify-center flex-shrink-0"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                  class="w-5 h-5 text-tech-blue"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"
                  ></path>
                </svg>
              </div>
              <div>
                <h3
                  class="font-medium text-gray-900"
                  data-i18n="contact.address"
                >
                  地址
                </h3>
                <!-- Chinese address -->
                <div data-lang-content="zh-TW">
                  <p class="text-gray-600">{zhData.address}</p>
                  <p class="text-gray-500 text-sm">{zhData.addressDetail}</p>
                </div>
                <!-- English address -->
                <div data-lang-content="en" style="display:none">
                  <p class="text-gray-600">{enData.address}</p>
                  <p class="text-gray-500 text-sm">{enData.addressDetail}</p>
                </div>
              </div>
            </div>

            <div class="flex items-start gap-4 p-4 rounded-xl bg-gray-50">
              <div
                class="w-10 h-10 rounded-lg bg-tech-blue/10 flex items-center justify-center flex-shrink-0"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                  class="w-5 h-5 text-tech-blue"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="font-medium text-gray-900" data-i18n="contact.email">
                  電子郵件
                </h3>
                <div class="space-y-1">
                  <!-- Chinese contact names -->
                  <div data-lang-content="zh-TW">
                    {
                      zhData.contacts?.map(
                        (contact: { name: string; email: string }) => (
                          <p class="text-gray-600">
                            <a
                              href={`mailto:${contact.email}`}
                              class="text-tech-blue hover:underline"
                            >
                              {contact.email}
                            </a>
                            <span class="text-gray-400"> — {contact.name}</span>
                          </p>
                        ),
                      )
                    }
                  </div>
                  <!-- English contact names -->
                  <div data-lang-content="en" style="display:none">
                    {
                      enData.contacts?.map(
                        (contact: { name: string; email: string }) => (
                          <p class="text-gray-600">
                            <a
                              href={`mailto:${contact.email}`}
                              class="text-tech-blue hover:underline"
                            >
                              {contact.email}
                            </a>
                            <span class="text-gray-400"> — {contact.name}</span>
                          </p>
                        ),
                      )
                    }
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Map -->
          <div class="rounded-xl overflow-hidden shadow-lg h-64">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3672.755!2d120.2194!3d22.9997!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x346e76e5b1e6e3e1%3A0x785e3c15e20c1c0a!2z5ZyL56uL5oiQ5Yqf5aSn5a24!5e0!3m2!1szh-TW!2stw!4v1700000000000!5m2!1szh-TW!2stw"
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              data-i18n-title="contact.mapTitle"
              title="國立成功大學位置"></iframe>
          </div>
        </div>

        <!-- Contact Form -->
        <div>
          <h2
            class="text-2xl font-heading font-bold text-gray-900 mb-8"
            data-i18n="contact.form"
          >
            聯絡表單
          </h2>
          <form class="space-y-6" id="contact-form">
            <div>
              <label
                for="name"
                class="block text-sm font-medium text-gray-700 mb-2"
                data-i18n="contact.form.name">姓名</label
              >
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-tech-blue focus:ring-2 focus:ring-tech-blue/20 outline-none transition-all text-gray-900"
                placeholder="請輸入您的姓名"
                data-i18n-placeholder="contact.form.namePlaceholder"
              />
            </div>
            <div>
              <label
                for="email"
                class="block text-sm font-medium text-gray-700 mb-2"
                data-i18n="contact.form.email">電子郵件</label
              >
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-tech-blue focus:ring-2 focus:ring-tech-blue/20 outline-none transition-all text-gray-900"
                placeholder="your@email.com"
                data-i18n-placeholder="contact.form.emailPlaceholder"
              />
            </div>
            <div>
              <label
                for="subject"
                class="block text-sm font-medium text-gray-700 mb-2"
                data-i18n="contact.form.subject">主旨</label
              >
              <input
                type="text"
                id="subject"
                name="subject"
                required
                class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-tech-blue focus:ring-2 focus:ring-tech-blue/20 outline-none transition-all text-gray-900"
                placeholder="請輸入主旨"
                data-i18n-placeholder="contact.form.subjectPlaceholder"
              />
            </div>
            <div>
              <label
                for="message"
                class="block text-sm font-medium text-gray-700 mb-2"
                data-i18n="contact.form.message">訊息內容</label
              >
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-tech-blue focus:ring-2 focus:ring-tech-blue/20 outline-none transition-all resize-none text-gray-900"
                placeholder="請輸入您的訊息..."
                data-i18n-placeholder="contact.form.messagePlaceholder"
              ></textarea>
            </div>
            <button
              type="submit"
              class="w-full btn-primary justify-center bg-tech-blue text-white py-4 rounded-xl text-lg"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="w-5 h-5"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5"
                ></path>
              </svg>
              <span data-i18n="contact.form.submit">送出訊息</span>
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
