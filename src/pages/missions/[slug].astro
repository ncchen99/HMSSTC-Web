---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import type { GetStaticPaths } from "astro";

export const getStaticPaths: GetStaticPaths = async () => {
  const allMissions = await getCollection("missions");
  const baseEntries = allMissions.filter(
    (entry) => !entry.id.endsWith(".en.md"),
  );

  return baseEntries.map((entry) => {
    const enId = entry.id.replace(".md", ".en.md");
    const translatedEntry = allMissions.find((e) => e.id === enId);
    return {
      params: { slug: entry.slug },
      props: { entry, translatedEntry },
    };
  });
};

const { entry, translatedEntry } = Astro.props;
const { Content } = await entry.render();
const TranslatedContent = translatedEntry
  ? (await translatedEntry.render()).Content
  : null;

interface Props {
  entry: CollectionEntry<"missions">;
  translatedEntry?: CollectionEntry<"missions">;
}
---

<BaseLayout
  title={`${entry.data.title} | 夏漢民太空科技中心`}
  titleEn={translatedEntry
    ? `${translatedEntry.data.title} | HMSSTC`
    : undefined}
>
  <div class="pt-28 pb-20 bg-white min-h-screen">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="mb-8 text-sm">
        <a
          href="/"
          class="text-gray-400 hover:text-tech-blue transition-colors"
          data-i18n="missionsPage.breadcrumbHome">首頁</a
        >
        <span class="text-gray-300 mx-2">/</span>
        <a
          href="/missions"
          class="text-gray-400 hover:text-tech-blue transition-colors"
          data-i18n="missionsPage.breadcrumbMissions">太空任務</a
        >
        <span class="text-gray-300 mx-2">/</span>
        <span class="text-gray-600" data-lang-content="zh-TW"
          >{entry.data.title}</span
        >
        <span
          class="text-gray-600"
          data-lang-content="en"
          style="display: none;"
        >
          {translatedEntry?.data.title ?? entry.data.title}
        </span>
      </nav>

      {
        entry.data.image && (
          <div class="relative h-64 md:h-96 rounded-2xl overflow-hidden mb-10">
            {typeof entry.data.image === "string" ? (
              <img
                src={entry.data.image}
                alt={entry.data.title}
                class="w-full h-full object-cover"
              />
            ) : (
              <Image
                src={entry.data.image}
                alt={entry.data.title}
                class="w-full h-full object-cover"
              />
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent" />
            <div class="absolute top-4 right-4">
              <span
                class={`px-4 py-2 rounded-full text-sm font-medium backdrop-blur-sm ${
                  entry.data.status === "active"
                    ? "bg-neon-green/20 text-neon-green border border-neon-green/30"
                    : "bg-gray-500/20 text-gray-300 border border-gray-500/30"
                }`}
              >
                {entry.data.status === "active" ? (
                  <span>
                    🟢 <span data-i18n="missionsPage.statusActive">執行中</span>
                  </span>
                ) : (
                  <span>
                    ⚪{" "}
                    <span data-i18n="missionsPage.statusRetired">已除役</span>
                  </span>
                )}
              </span>
            </div>
          </div>
        )
      }

      <div class="mb-8">
        <h1
          class="text-3xl md:text-4xl font-heading font-bold text-gray-900 mb-4"
          data-lang-content="zh-TW"
        >
          {entry.data.title}
        </h1>
        <h1
          class="text-3xl md:text-4xl font-heading font-bold text-gray-900 mb-4"
          data-lang-content="en"
          style="display: none;"
        >
          {translatedEntry?.data.title ?? entry.data.title}
        </h1>
        <p class="text-gray-500">
          <span data-i18n="missionsPage.datePrefix">公告時間</span>
          <span data-lang-content="zh-TW">{entry.data.date}</span>
          <span data-lang-content="en" style="display: none;">
            {translatedEntry?.data.date ?? entry.data.date}
          </span>
        </p>
      </div>

      <div
        class="prose prose-lg max-w-none prose-headings:font-heading prose-headings:text-gray-900 prose-p:text-gray-600 prose-a:text-tech-blue prose-li:text-gray-600"
        data-lang-content="zh-TW"
      >
        <Content />
      </div>

      <div
        class="prose prose-lg max-w-none prose-headings:font-heading prose-headings:text-gray-900 prose-p:text-gray-600 prose-a:text-tech-blue prose-li:text-gray-600"
        data-lang-content="en"
        style="display: none;"
      >
        {
          TranslatedContent ? (
            <TranslatedContent />
          ) : (
            <>
              <div class="p-4 bg-yellow-50 border border-yellow-200 rounded-lg text-yellow-800 mb-4">
                Content not available in English.
              </div>
              <div class="opacity-50">
                <Content />
              </div>
            </>
          )
        }
      </div>

      <div class="mt-12 pt-8 border-t border-gray-100">
        <a
          href="/missions"
          class="inline-flex items-center gap-2 text-tech-blue font-medium hover:gap-3 transition-all duration-300"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            class="w-4 h-4"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"></path>
          </svg>
          <span data-i18n="missionsPage.backToMissions">返回太空任務</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
