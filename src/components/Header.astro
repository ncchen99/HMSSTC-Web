---
const navItems = [
  { label: "最新消息", href: "/news", i18nKey: "nav.news" },
  { label: "關於中心", href: "/about", i18nKey: "nav.about" },
  { label: "太空任務", href: "/missions", i18nKey: "nav.missions" },
  { label: "活動花絮", href: "/activities", i18nKey: "nav.activities" },
  { label: "聯絡我們", href: "/contact", i18nKey: "nav.contact" },
];

const { transparent = false } = Astro.props;

const currentPath = Astro.url.pathname;
---

<header
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-500"
  id="main-header"
  data-transparent={transparent.toString()}
>
  <div class="header-bg-provider transition-all duration-500">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-20">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-3 group">
          <img src="/images/logo.svg" alt="HMSSTC Logo" class="h-12 w-auto" />
        </a>

        <!-- Desktop Nav -->
        <nav class="hidden lg:flex items-center gap-8">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                data-i18n={item.i18nKey}
                class={`text-sm font-medium tracking-wide transition-colors duration-200 hover:text-tech-blue-light ${
                  currentPath.startsWith(item.href)
                    ? "text-tech-blue-light"
                    : "text-gray-300"
                }`}
              >
                {item.label}
              </a>
            ))
          }
          <button
            data-lang-switch
            onclick="window.__setLang(window.__getLang() === 'en' ? 'zh-TW' : 'en')"
            class="ml-4 px-4 py-2 border border-white/20 rounded text-sm text-gray-400 hover:border-tech-blue-light hover:text-tech-blue-light transition-all cursor-pointer"
          >
            EN
          </button>
        </nav>

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-btn"
          class="lg:hidden text-white p-2"
          aria-label="Toggle menu"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-6 h-6"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="lg:hidden fixed inset-0 top-20 bg-space-dark/95 backdrop-blur-lg transform translate-x-full transition-transform duration-300 z-40"
  >
    <nav class="flex flex-col items-center gap-6 pt-12">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            data-i18n={item.i18nKey}
            class={`text-lg font-medium tracking-wide transition-colors duration-200 hover:text-tech-blue-light ${
              currentPath.startsWith(item.href)
                ? "text-tech-blue-light"
                : "text-gray-300"
            }`}
          >
            {item.label}
          </a>
        ))
      }
      <button
        data-lang-switch
        onclick="window.__setLang(window.__getLang() === 'en' ? 'zh-TW' : 'en')"
        class="mt-4 px-6 py-2 border border-white/20 rounded text-gray-400 hover:border-tech-blue-light hover:text-tech-blue-light transition-all cursor-pointer"
      >
        EN
      </button>
    </nav>
  </div>
</header>

<style>
  /* Base state for standard pages or when scrolled */
  .header-bg-provider {
    background-color: rgba(5, 13, 26, 0.9);
    backdrop-filter: blur(12px);
    height: 80px;
  }

  /* Special transparent gradient state for Hero banners */
  #main-header.is-at-top[data-transparent="true"] .header-bg-provider {
    background: linear-gradient(
      to bottom,
      rgba(5, 13, 26, 1) 0%,
      rgba(5, 13, 26, 0.7) 40%,
      rgba(5, 13, 26, 0) 100%
    );
    backdrop-filter: blur(0px);
    height: 120px;
    padding-top: 10px;
  }

  /* Shadow added only when scrolled */
  #main-header.shadow-active {
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
  }
</style>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  let isOpen = false;

  btn?.addEventListener("click", () => {
    isOpen = !isOpen;
    if (isOpen) {
      menu?.classList.remove("translate-x-full");
      menu?.classList.add("translate-x-0");
    } else {
      menu?.classList.remove("translate-x-0");
      menu?.classList.add("translate-x-full");
    }
  });

  // Header background on scroll
  const header = document.getElementById("main-header");
  const isTransparentEnabled =
    header?.getAttribute("data-transparent") === "true";

  function handleScroll() {
    const scrollPos = window.scrollY;

    if (scrollPos > 20) {
      header?.classList.remove("is-at-top");
      header?.classList.add("shadow-active");
    } else {
      header?.classList.remove("shadow-active");
      if (isTransparentEnabled) {
        header?.classList.add("is-at-top");
      } else {
        header?.classList.remove("is-at-top");
      }
    }
  }

  window.addEventListener("scroll", handleScroll);
  // Initial check
  handleScroll();
</script>
